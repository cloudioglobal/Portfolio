{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloudioglobal/Portfolio/schema/case-study.schema.json",
  "title": "CaseStudy",
  "description": "A deeper narrative write-up of a client or employer engagement, optionally anonymised. Mirrors the CaseStudy entity on the live site.",
  "type": "object",
  "properties": {
    "title": { "type": "string", "description": "Case study title" },
    "slug": { "type": "string", "description": "URL-friendly identifier / folder name" },
    "client_name": { "type": "string", "description": "Client name or 'Confidential' for anonymised cases" },
    "industry": { "type": "string", "description": "Industry sector" },
    "context": { "type": "string", "description": "Background and context" },
    "challenge": { "type": "string", "description": "The problem or challenge faced" },
    "approach": { "type": "string", "description": "How the solution was approached" },
    "outcome": { "type": "string", "description": "Results and outcomes achieved" },
    "learnings": { "type": "string", "description": "Key learnings and insights" },
    "services_used": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Services applied in this engagement"
    },
    "engagement_type": {
      "type": "string",
      "enum": ["advisory", "hands-on", "interim"],
      "description": "Type of engagement"
    },
    "is_anonymised": {
      "type": "boolean",
      "default": false,
      "description": "Whether client details are anonymised"
    },
    "featured_image": { "type": "string", "description": "URL to featured image" },
    "published": { "type": "boolean", "default": false },
    "publish_date": { "type": "string", "format": "date" },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description (up to 1000 characters)"
    }
  },
  "required": ["slug", "title"]
}
