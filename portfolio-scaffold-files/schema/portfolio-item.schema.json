{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloudioglobal/Portfolio/schema/portfolio-item.schema.json",
  "title": "PortfolioItem",
  "description": "A working app, website, prototype, GitHub repo, or standalone case study featured on the Portfolio page of cloudioconsulting.com. Field names and meanings mirror the PortfolioItem entity used on the live site (Base44) so the two stay comparable.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Project title"
    },
    "description": {
      "type": "string",
      "maxLength": 180,
      "description": "Short public summary (max 180 characters)"
    },
    "type": {
      "type": "string",
      "enum": ["app", "website", "prototype", "github", "case_study", "other"],
      "description": "Type of portfolio item"
    },
    "project_status": {
      "type": "string",
      "enum": ["live", "in_development", "maintenance", "archived", "conceptual", "alpha", "beta", "mvp"],
      "default": "live",
      "description": "Project lifecycle status"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Hero image URL"
    },
    "live_demo_url": {
      "type": "string",
      "description": "Live demo URL"
    },
    "github_url": {
      "type": "string",
      "description": "GitHub repository URL"
    },
    "website_url": {
      "type": "string",
      "description": "Website URL"
    },
    "context_challenge": {
      "type": "string",
      "description": "The Context/Challenge — the problem that needed solving"
    },
    "solution_process": {
      "type": "string",
      "description": "The Solution/Process — what was designed and built"
    },
    "artifacts_deliverables": {
      "type": "string",
      "description": "The Artifacts/Deliverables — tangible things produced"
    },
    "outcome_impact": {
      "type": "string",
      "description": "The Outcome/Impact — measurable success that followed"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Featured project"
    },
    "status": {
      "type": "string",
      "enum": ["published", "draft"],
      "default": "published",
      "description": "Publish status of this entry (mirrors the site's published/draft flag — draft entries are excluded from index.json)"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "slug": {
      "type": "string",
      "description": "Folder name / URL-friendly identifier for this entry, e.g. 'canonical-maas-provisioning'"
    }
  },
  "required": ["slug", "title", "description", "type"]
}
